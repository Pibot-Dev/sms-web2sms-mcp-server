WEB2SMS_API_KEY=your-api-key
WEB2SMS_SECRET=your-secret
WEB2SMS_SENDER=
PORT=3000

# WhatsApp via WAHA (https://waha.devlike.pro)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Anti-ban pacing
WAHA_MIN_DELAY_MS=20000
WAHA_MAX_DELAY_MS=60000
WAHA_HOURLY_LIMIT=40
WAHA_MAX_SERIES_SIZE=50
WAHA_MAX_CONSECUTIVE_FAILURES=3
